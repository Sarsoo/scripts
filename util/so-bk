#!/usr/bin/env bash
# sarsoo: summary="fzf directory switcher backed by ~/.bk bookmarks"
# sarsoo: visibility="public"
#
# Reads one directory per line from ~/.bk, lets you pick with fzf, and prints
# the selection to stdout. A script cannot change its parent shell's directory,
# so cd from the caller:
#
#   cd "$(so bk)"
#
# Or use the `bk` shell function (in ~/.sarc) to switch directly:
#
#   bk() { local d; d="$(so bk)" && [[ -n $d ]] && cd "$d"; }

set -uo pipefail

bk_file="${BK_FILE:-$HOME/.bk}"

if [[ "${1:-}" == "--help" ]]; then
    cat <<EOF
Usage: so bk

Pick a bookmarked directory with fzf and print it to stdout.

Bookmarks come from $bk_file (override with \$BK_FILE), one directory
per line. Blank lines and lines starting with '#' are ignored.
Entries may use a leading ~ (for \$HOME) and \$VAR / \${VAR} expansion.

Examples:
  bk              change the current directory (via the ~/.sarc function)
  cd "\$(so bk)"   compose it yourself
EOF
    exit 0
fi

if [[ ! -f "$bk_file" ]]; then
    printf 'err: bookmark file not found: %s\n' "$bk_file" >&2
    printf 'Create it with one directory path per line.\n' >&2
    exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
    printf 'err: fzf could not be found\n' >&2
    exit 1
fi

# Expand a bookmark entry: a leading ~ becomes $HOME, then $VAR / ${VAR} are
# expanded. Command substitution is refused so a bookmark file cannot execute
# commands. Runs after selection, so the picker shows entries as written.
expand_path() {
    local value="$1"

    case "$value" in
        '~')   value='$HOME' ;;
        '~/'*) value='$HOME/'"${value#\~/}" ;;
    esac

    if [[ "$value" == *'$('* || "$value" == *'`'* ]]; then
        printf 'warn: not expanding command substitution: %s\n' "$1" >&2
        printf '%s\n' "$1"
        return 0
    fi

    # Escape backslashes and quotes so the value survives `eval` intact.
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"

    # Undefined variables expand to empty rather than tripping `set -u`.
    set +u
    eval "printf '%s\n' \"$value\""
    set -u
}

# Internal hook for the fzf preview: resolve one entry and print it.
if [[ "${1:-}" == "--expand" ]]; then
    shift
    [[ $# -eq 1 ]] || { printf 'err: --expand takes exactly one path\n' >&2; exit 2; }
    expand_path "$1"
    exit 0
fi

# Strip blank lines and full-line comments, keep the rest verbatim.
selection="$(
    awk '!/^[[:space:]]*(#|$)/' "$bk_file" \
        | fzf --prompt='bookmark> ' \
              --height='40%' \
              --reverse \
              --preview='ls -C --color=always "$(so bk --expand {})" 2>/dev/null | head -50'
)" || exit 1

[[ -n "$selection" ]] || exit 1

expand_path "$selection"
