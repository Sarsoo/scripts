#!/usr/bin/env bash
# sarsoo: summary="fzf directory switcher backed by ~/.bk bookmarks"
# sarsoo: visibility="public"
#
# Reads one directory per line from ~/.bk, lets you pick with fzf, and prints
# the selection to stdout. A script cannot change its parent shell's directory,
# so cd from the caller:
#
#   cd "$(so bk)"
#
# Or use the `bk` shell function (in ~/.sarc) to switch directly:
#
#   bk() { local d; d="$(so bk)" && [[ -n $d ]] && cd "$d"; }
#
# If the picked bookmark is the root of a git worktree tree (a `git-wtclone`
# checkout: a <name>.git repository directory beside a .git file pointing at
# it), a second picker lists that tree's worktrees and the chosen one is
# printed. Cancelling that picker falls back to the tree root.

set -uo pipefail

bk_file="${BK_FILE:-$HOME/.bk}"

if [[ "${1:-}" == "--help" ]]; then
    cat <<EOF
Usage: so bk

Pick a bookmarked directory with fzf and print it to stdout.

Bookmarks come from $bk_file (override with \$BK_FILE), one directory
per line. Blank lines and lines starting with '#' are ignored.
Entries may use a leading ~ (for \$HOME) and \$VAR / \${VAR} expansion.

Examples:
  bk              change the current directory (via the ~/.sarc function)
  cd "\$(so bk)"   compose it yourself

If a picked bookmark is the root of a git worktree tree (as created by
 git-wtclone), a second fzf picker lists its worktrees; the selected worktree
 path is printed instead of the root. Cancelling that second picker prints
 the tree root.
EOF
    exit 0
fi

if [[ ! -f "$bk_file" ]]; then
    printf 'err: bookmark file not found: %s\n' "$bk_file" >&2
    printf 'Create it with one directory path per line.\n' >&2
    exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
    printf 'err: fzf could not be found\n' >&2
    exit 1
fi

# Expand a bookmark entry: a leading ~ becomes $HOME, then $VAR / ${VAR} are
# expanded. Command substitution is refused so a bookmark file cannot execute
# commands. Runs after selection, so the picker shows entries as written.
expand_path() {
    local value="$1"

    case "$value" in
        '~')   value='$HOME' ;;
        '~/'*) value='$HOME/'"${value#\~/}" ;;
    esac

    if [[ "$value" == *'$('* || "$value" == *'`'* ]]; then
        printf 'warn: not expanding command substitution: %s\n' "$1" >&2
        printf '%s\n' "$1"
        return 0
    fi

    # Escape backslashes and quotes so the value survives `eval` intact.
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"

    # Undefined variables expand to empty rather than tripping `set -u`.
    set +u
    eval "printf '%s\n' \"$value\""
    set -u
}

# Internal hook for the fzf preview: resolve one entry and print it.
if [[ "${1:-}" == "--expand" ]]; then
    shift
    [[ $# -eq 1 ]] || { printf 'err: --expand takes exactly one path\n' >&2; exit 2; }
    expand_path "$1"
    exit 0
fi

# A worktree tree root holds a <name>.git repository directory next to a .git
# file that points at it. Ordinary worktrees have a .git file too, but no
# sibling repo directory, so this is what tells the two apart.
is_worktree_root() {
    local dir="$1" candidate

    [[ -d "$dir" && -f "$dir/.git" ]] || return 1
    for candidate in "$dir"/*.git; do
        [[ -d "$candidate" ]] || continue
        [[ -e "$candidate/.git" || -f "$candidate/HEAD" ]] && return 0
    done
    return 1
}

# Second picker: list the worktrees of a tree rooted at $1 and print the
# chosen path. Returns non-zero if there is nothing to pick or fzf is
# cancelled; the caller then falls back to the tree root.
pick_worktree() {
    local dir="$1" selection

    selection="$(
        git -C "$dir" worktree list --porcelain 2>/dev/null \
            | awk -v root="$dir" '
                /^worktree / { path = substr($0, 10); next }
                /^bare/      { path = ""; next }
                /^$/ {
                    if (path != "") print (path ~ /^\// ? path : root "/" path)
                    path = ""
                }
                END {
                    if (path != "") print (path ~ /^\// ? path : root "/" path)
                }
            ' \
            | fzf --prompt='worktree> ' \
                  --height='40%' \
                  --reverse \
                  --preview='d={}; git -C "$d" status --short --branch 2>/dev/null; ls -C --color=always "$d" 2>/dev/null | head -30'
    )" || return 1

    [[ -n "$selection" ]] || return 1
    printf '%s\n' "$selection"
}

# Strip blank lines and full-line comments, keep the rest verbatim.
selection="$(
    awk '!/^[[:space:]]*(#|$)/' "$bk_file" \
        | fzf --prompt='bookmark> ' \
              --height='40%' \
              --reverse \
              --preview='ls -C --color=always "$(so bk --expand {})" 2>/dev/null | head -50'
)" || exit 1

[[ -n "$selection" ]] || exit 1

target="$(expand_path "$selection")"
[[ -n "$target" ]] || exit 1

if is_worktree_root "$target"; then
    pick_worktree "$target" || printf '%s\n' "$target"
else
    printf '%s\n' "$target"
fi
