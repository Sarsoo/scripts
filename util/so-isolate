#!/usr/bin/env bash
# sarsoo: summary="Isolate the given command using bwrap"
# sarsoo: visibility="public"
set -euo pipefail

usage() {
  cat <<EOF
Usage: so isolate

Isolate a command using bwrap to selectively re-mount
some parts of the root filesystem
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

if ! command -v bwrap >/dev/null 2>&1; then
    printf 'err: bwrap could not be found\n' >&2
    exit 1
fi

# Skip re-isolating if already inside an isolated environment
if [[ -n "${ISOLATE_ENV:-}" ]]; then
	>&2 echo "warning: already isolated"
	exec "$@"
fi

tiocsti_path="/proc/sys/dev/tty/legacy_tiocsti"
if [ ! -f "$tiocsti_path" ] || [ "$(cat "$tiocsti_path")" != "0" ]; then
	>&2 echo "warning: TIOCSTI not disabled"
fi

args=()

args+=(
  --dev /dev \
	--proc /proc \
	--tmpfs /run \
 	--setenv PROMPT_ENV_INDICATOR "isolated" \
 	--setenv ISOLATE_ENV "$(pwd)"
)

# DNS: /etc/resolv.conf is a symlink to ../run/systemd/resolve/stub-resolv.conf,
# but /run is a fresh tmpfs here. Re-create the target so the symlink resolves.
if [ -e /run/systemd/resolve/stub-resolv.conf ]; then
    args+=(--ro-bind /run/systemd/resolve/stub-resolv.conf \
           /run/systemd/resolve/stub-resolv.conf)
fi

# READ-ONLY
for p in \
	/bin \
	/usr \
	/lib \
	/lib64 \
	/etc \
	/opt/microsoft \
	/var/lib/sss/mc \
	"$HOME/.config" \
	"$HOME/.profile" \
	"$HOME/.bashrc" \
	"$HOME/.sarc" \
	"$HOME/.local" \
	"$HOME/.gitconfig" \
	"$HOME/.cargo" \
	"$HOME/.rustup" \
	"$HOME/.nvm" \
	; do
	args+=(--ro-bind-try "$p" "$p")
done

# READ-WRITE
for p in \
  "$HOME/dotfiles" \
  "$HOME/.pi" \
  "$HOME/.config/herdr" \
  "$HOME/.hindsight" \
  "$HOME/.opencode" \
  "$HOME/.config/opencode" \
  "$HOME/.local/share/opencode" \
  "$HOME/.local/state/opencode" \
  "$HOME/.cache/opencode" \
  "$HOME/.config/powershell" \
  "$HOME/.local/share/powershell" \
  "$HOME/.cache/powershell" \
  "$HOME/.agents" \
  "$HOME/.codegraph" \
	"$HOME/.dotnet" \
	"$HOME/.npmrc" \
	"$HOME/.npm" \
	"$HOME/.aspnet" \
	"$HOME/.local/share/NuGet" \
	"$HOME/.nuget" \
	"$HOME/.terraform.d" \
	"$HOME/.terraformrc" \
	; do
	args+=(--bind-try "$p" "$p")
done

if [[ "$PWD" != "$HOME" && "$HOME" != "$PWD"/* ]]; then
   args+=(--bind-try "$(pwd)" "$(pwd)")
fi

# READ-WRITE
for p in \
  "HOME" \
  "USER" \
	; do
	args+=(--setenv "$p" "${!p}")
done

args+=(
  --die-with-parent --new-session \
  --unshare-pid --unshare-ipc --unshare-uts --share-net \
  --chdir "$PWD"
)

# Source extra config (e.g. set by auto-isolate) to allow
# project-specific additions to args
if [[ -n "${ISOLATE_EXTRA_CONFIG:-}" && -f "$ISOLATE_EXTRA_CONFIG" ]]; then
	source "$ISOLATE_EXTRA_CONFIG"
	# Hide the config file inside the sandbox by overlaying /dev/null
	args+=(--ro-bind /dev/null "$ISOLATE_EXTRA_CONFIG")
fi

exec bwrap \
	"${args[@]}" \
	-- "$@"
