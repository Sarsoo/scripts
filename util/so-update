#!/usr/bin/env bash
# sarsoo: summary="Update script checkout"
# sarsoo: visibility="public"

set -ueo pipefail

usage() {
  cat <<EOF
Usage: so update

Update the local checkout of scripts
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

pushd "${SARSOO_LIB_DIR}/.." >/dev/null
git pull
popd >/dev/null
