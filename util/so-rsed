#!/usr/bin/env bash
# sarsoo: summary="recursive sed"
# sarsoo: visibility="public"

usage() {
  cat <<'EOF'
Usage: so rsed [options] [positionals]

Recursive sed

Options:
  -f, --file  PATTERN       Chart directory (default: .)
  -s, --sed   TEMPLATE      Directory to output templates to (default: ./templated)
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

file=""
sed=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--file)
            file="$2"
            shift 2
            ;;
        -s|--sed)
            sed="$2"
            shift 2
            ;;
    esac
done

: "${file:?}" "${sed:?}"

unameOut="$(uname -s)"
case "${unameOut}" in
    Darwin*)    machine=Mac;;
    *)          machine="UNKNOWN:${unameOut}"
esac

if [[ "${machine}" == "Mac" ]]; then
  find . -type f -name "${file}" -print0 | xargs -0 sed -i '' "${sed}"
else
  find . -type f -name "${file}" -print0 | xargs -0 sed -i "${sed}"
fi
