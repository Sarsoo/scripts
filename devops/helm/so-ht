#!/usr/bin/env bash
# sarsoo: summary="Template Helm charts out to a given directory"
# sarsoo: visibility="public"
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: so ht [options] [positionals]

Tempplate out a helm chart to a given directory

Options:
  -c, --chart DIR       Chart directory (default: .)
  -o, --output-dir DIR  Directory to output templates to (default: ./templated)
  -h, --help            Show this help
EOF
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
  esac
done

if ! command -v helm >/dev/null; then
  echo "failed to find helm install" >&2
  exit 1
fi

chart_dir="$(pwd)"
output_dir="$(pwd)/templated"
positionals=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -c|--chart)
            chart_dir="$2"
            shift 2
            ;;
        -o|--output-dir)
            output_dir="$2"
            shift 2
            ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

[[ -d "${output_dir}" ]] && rm -rf "${output_dir}"

helm template temp-temp "${chart_dir}" "${positionals[@]}" --output-dir "${output_dir}"
