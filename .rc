
unameOut="$(uname -s)"
case "${unameOut}" in
    Linux*)     machine=Linux;;
    Darwin*)    machine=Mac;;
    CYGWIN*)    machine=Cygwin;;
    MINGW*)     machine=MinGw;;
    MSYS_NT*)   machine=MSys;;
    *)          machine="UNKNOWN:${unameOut}"
esac

SAR_SCRIPT_ROOT=${SAR_SCRIPT_ROOT:-"$HOME/scripts"}

export PATH="$PATH:${SAR_SCRIPT_ROOT}"

export PATH="$PATH:${SAR_SCRIPT_ROOT}/dev"
export PATH="$PATH:${SAR_SCRIPT_ROOT}/devops"

if command -v zfs >/dev/null 2>&1; then
    export PATH="$PATH:${SAR_SCRIPT_ROOT}/zfs"
fi

if command -v vja >/dev/null 2>&1; then
    export PATH="$PATH:${SAR_SCRIPT_ROOT}/vja"
fi

if command -v kubectl >/dev/null 2>&1; then
    export PATH="$PATH:${SAR_SCRIPT_ROOT}/devops/k8s"
fi

if [[ "${machine}" == "Mac" ]]; then
    export PATH="$PATH:${SAR_SCRIPT_ROOT}/mac"
fi
